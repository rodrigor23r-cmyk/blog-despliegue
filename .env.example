DOMINIO=ejemplo.com
MYSQL_ROOT_PASSWORD=cambiame
MYSQL_DATABASE=blog
MYSQL_USER=developer
MYSQL_PASSWORD=cambiame
JWT_SECRET=cambiame-base64-de-48-bytes

# ---------- gastos ----------
# La contraseña y el secreto NO se escriben a mano: los genera preparar-gastos.sh.
# GASTOS_JWT_SECRET debe ser distinto del JWT_SECRET del blog y del de local.
GASTOS_DB_USER=gastos_user
GASTOS_DB_PASSWORD=cambiame-openssl-rand-base64-24
GASTOS_JWT_SECRET=cambiame-openssl-rand-base64-64
# La aplicacion NO ARRANCA sin esta: la propiedad no tiene valor por defecto, a proposito.
GASTOS_IA_API_KEY=cambiame-clave-de-google-ai-studio

# ---------- correo transaccional (común a todas las aplicaciones) ----------
# Brevo (D49 de cuadrante). Lo escribe preparar-cuadrante.sh: el usuario lo pregunta
# y la clave la pide sin mostrarla. Nunca a mano, nunca en git.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=cambiame-usuario@smtp-brevo.com

# ---------- cuadrante ----------
# La contraseña y el secreto NO se escriben a mano: los genera preparar-cuadrante.sh.
# CUADRANTE_JWT_SECRET debe ser distinto del de gastos, del del blog y del de local.
CUADRANTE_DB_USER=cuadrante_user
CUADRANTE_DB_PASSWORD=cambiame-openssl-rand-base64-24
CUADRANTE_JWT_SECRET=cambiame-openssl-rand-base64-64
# Una clave SMTP por aplicación ('cuadrante-prod' en Brevo): se anula sin tocar las demás.
CUADRANTE_SMTP_PASSWORD=cambiame-clave-smtp-de-brevo
