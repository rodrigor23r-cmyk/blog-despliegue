# Fragmento de registro. Se usa con: import registro <nombre-del-fichero>
(registro) {
      log {
            output file /var/log/caddy/{args[0]}.log {
                  roll_size 10MB
                  roll_keep 5
                  mode 644
            }
            format json
      }
}

# ---------- Sitio principal: el Angular ----------
{$DOMINIO} {
      import registro blog-web
      encode gzip zstd

      root * /srv/angular
      try_files {path} /index.html
      file_server

      @estaticos path *.js *.css *.woff2 *.png *.svg *.ico
      header @estaticos Cache-Control "public, max-age=31536000, immutable"

      @html path *.html /
      header @html Cache-Control "no-cache"
}

# ---------- www redirige al dominio principal ----------
www.{$DOMINIO} {
      redir https://{$DOMINIO}{uri} permanent
}

# ---------- API: pasarela al backend ----------
api.{$DOMINIO} {
      import registro blog-api
      encode gzip

      # Las imágenes las sirve Caddy directamente desde el volumen.
      # NO pasan por Spring Boot.
      handle_path /api/uploads/posts/* {
              root * /srv/uploads/posts
              header Cache-Control "public, max-age=31536000, immutable"
              file_server
      }

      # Todo lo demás sí va al backend
      handle {
              reverse_proxy backend:8080
      }
}

# ---------- API de gastos ----------
api.gastos.{$DOMINIO} {
      import registro gastos-api
      encode gzip

      # Sin handle_path para ficheros: las fotos de tickets no se persisten (D10),
      # así que TODO va al backend. El bloque de gastos.{$DOMINIO} se añadirá
      # cuando exista el contenedor del frontend.
      reverse_proxy gastos-api:8080
}
